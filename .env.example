# =====================================================================
# ReconForge Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file to public version control!
# =====================================================================

# Telegram Bot Alerting
# (Get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL (For channel alerts & embeds)
DISCORD_WEBHOOK_URL=

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# Generic HTTP Webhook endpoint (Receives JSON payloads)
RECONFORGE_WEBHOOK=

# Authorization confirmation bypass (Set to 1 only in automated CI/CD pipelines)
RECONFORGE_AUTHORIZED=0
